      "defaults": {
        "schema_version": 1,
        "interactions": {
          "planning": {"model": "gpt-5.6-sol", "reasoning": {"mode": "adaptive"}},
          "implementation": {"model": "gpt-5.6-terra", "reasoning": {"mode": "adaptive"}},
          "native-review": {"model": "gpt-5.6-sol", "reasoning": {"mode": "adaptive"}},
