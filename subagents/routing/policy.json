    {"id": "gpt-5.6-terra", "label": "GPT-5.6 Terra", "provider": "codex", "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"]},
    {"id": "gpt-5.6-luna", "label": "GPT-5.6 Luna", "provider": "codex", "efforts": ["low", "medium", "high", "xhigh", "max"]},
