          "claude-review": {"model": "opus", "reasoning": {"mode": "adaptive"}}
        },
        "adaptive_profiles": {
          "codex:gpt-6-astra": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "xhigh"}},
          "codex:gpt-5.6-sol": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "xhigh"}},
          "codex:gpt-5.6-terra": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "xhigh"}},
          "codex:gpt-5.6-luna": {"tiers": {"straightforward": "high", "involved": "xhigh", "demanding": "max"}},
          "claude:default": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "claude:opus": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "claude:opus[1m]": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "claude:claude-fable-5-1[1m]": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "claude:sonnet": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "claude:claude-opus-5": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}}
        }
      }
    },
    "claude": {
      "interactions": [
        {"id": "planning", "label": "Planning and design", "execution": "native", "default_model": "sonnet"},
        {"id": "implementation", "label": "Implementation and testing", "execution": "native", "default_model": "haiku"},
        {"id": "native-review", "label": "Native code review", "execution": "native", "default_model": "sonnet"},
        {"id": "visual-review", "label": "Visual and UX review", "execution": "native", "default_model": "sonnet"},
        {"id": "codex-review", "label": "Codex cross-review", "execution": "external", "default_model": "gpt-6.1-sol"}
      ],
      "defaults": {
        "schema_version": 1,
        "interactions": {
          "planning": {"model": "sonnet", "reasoning": {"mode": "adaptive"}},
          "implementation": {"model": "haiku", "reasoning": {"mode": "adaptive"}},
          "native-review": {"model": "sonnet", "reasoning": {"mode": "adaptive"}},
          "visual-review": {"model": "sonnet", "reasoning": {"mode": "adaptive"}},
          "codex-review": {"model": "gpt-6.1-sol", "reasoning": {"mode": "adaptive"}}
        },
        "adaptive_profiles": {
          "claude:sonnet": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "claude:haiku": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "claude:opus": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "high"}},
          "codex:gpt-6.1-sol": {"tiers": {"straightforward": "medium", "involved": "high", "demanding": "xhigh"}}
        }
      }
    }
  }
}
